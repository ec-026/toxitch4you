/*.swf
  Content-Type: application/x-shockwave-flash
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
/*.webp
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache
